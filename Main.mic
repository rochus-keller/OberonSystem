  Modules.Register("Edit", "CopyLooks", Edit.CopyLooks)
  Modules.Register("Edit", "ChangeFont", Edit.ChangeFont)
  Modules.Register("Edit", "ChangeColor", Edit.ChangeColor)
  Modules.Register("Edit", "ChangeOffset", Edit.ChangeOffset)
  Modules.Register("Edit", "Search", Edit.Search)
  Modules.Register("Edit", "Locate", Edit.Locate)
  Modules.Register("Edit", "Recall", Edit.Recall)

  Modules.Register("Draw", "Open", Draw.Open)
  Modules.Register("Draw", "Delete", Draw.Delete)
  Modules.Register("Draw", "SetWidth", Draw.SetWidth)
  Modules.Register("Draw", "ChangeColor", Draw.ChangeColor)
  Modules.Register("Draw", "ChangeWidth", Draw.ChangeWidth)
  Modules.Register("Draw", "ChangeFont", Draw.ChangeFont)
