module MIC$ // RK 2026

// Freestanding replacement of the built-in MIC$ runtime interface, for a target
// which has no C library. The operations themselves are implemented in MIC.mic;
// this module only exists because the generated code refers to the MIC$ names.

import MIC

type _$1 = array of char
type _$2 = pointer to _$1
type _$3 = pointer to char
type _$4 = pointer to uint8

procedure relop1* (lhs: _$2; rhs: _$2; op: int32): uint32
begin
  ldarg_0
  ldarg_1
  ldarg_2
  call MIC!relop1
  ret
end relop1

procedure relop2* (lhs: _$2; rhs: char; op: int32): uint32
begin
  ldarg_0
  ldarg_1
  ldarg_2
  call MIC!relop2
  ret
end relop2

procedure relop3* (lhs: char; rhs: _$2; op: int32): uint32
begin
  ldarg_0
  ldarg_1
  ldarg_2
  call MIC!relop3
  ret
end relop3

procedure relop4* (lhs: char; rhs: char; op: int32): uint32
begin
  ldarg_0
  ldarg_1
  ldarg_2
  call MIC!relop4
  ret
end relop4

